---
import BaseLayout from '@layouts/BaseLayout.astro';
import App from '@components/App';
---

<BaseLayout>
  <!-- Hero Section with Animated Background -->
  <section class="relative min-h-[70vh] flex flex-col items-center justify-center text-center mb-20 overflow-hidden">
    <!-- Animated gradient blobs -->
    <div class="absolute inset-0 -z-10">
      <div class="absolute top-20 left-1/4 w-96 h-96 bg-purple-400/30 rounded-full mix-blend-multiply filter blur-3xl opacity-70 animate-blob"></div>
      <div class="absolute top-20 right-1/4 w-96 h-96 bg-pink-400/30 rounded-full mix-blend-multiply filter blur-3xl opacity-70 animate-blob" style="animation-delay: 2s;"></div>
      <div class="absolute -bottom-8 left-1/3 w-96 h-96 bg-orange-400/30 rounded-full mix-blend-multiply filter blur-3xl opacity-70 animate-blob" style="animation-delay: 4s;"></div>
    </div>

    <!-- Grid pattern overlay -->
    <div class="absolute inset-0 -z-10 opacity-10" style="background-image: linear-gradient(to right, #80808020 1px, transparent 1px), linear-gradient(to bottom, #80808020 1px, transparent 1px); background-size: 40px 40px;"></div>

    <!-- Hero Content -->
    <div class="relative z-10 max-w-4xl mx-auto px-4 space-y-8 animate-slide-up">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/80 backdrop-blur-sm border border-purple-200 shadow-lg">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-purple-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-purple-500"></span>
        </span>
        <span class="text-sm font-medium text-gray-700">AI-Powered Content Generator</span>
      </div>

      <!-- Main Heading -->
      <h1 class="text-5xl md:text-7xl font-black tracking-tight">
        <span class="block mb-2">Twórz Posty na</span>
        <span class="block bg-gradient-to-r from-purple-600 via-pink-600 to-orange-500 bg-clip-text text-transparent">
          Instagram
        </span>
        <span class="block mt-2 text-4xl md:text-6xl">w Sekundach ⚡</span>
      </h1>

      <!-- Subheading -->
      <p class="text-xl md:text-2xl text-gray-600 max-w-2xl mx-auto leading-relaxed">
        Wykorzystaj moc AI do generowania <span class="font-semibold text-purple-600">angażującego contentu</span> z automatycznymi hashtagami i propozycjami zdjęć
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
        <a href="#generator" class="group relative px-8 py-4 rounded-xl font-bold text-white overflow-hidden transition-all hover:scale-105 active:scale-95">
          <div class="absolute inset-0 bg-gradient-to-r from-purple-600 via-pink-600 to-orange-500 bg-[length:200%_auto] animate-gradient"></div>
          <span class="relative flex items-center gap-2">
            Rozpocznij Za Darmo
            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </span>
        </a>
        <a href="#features" class="px-8 py-4 rounded-xl font-semibold bg-white/80 backdrop-blur-sm border-2 border-gray-200 hover:border-purple-300 transition-all hover:scale-105 active:scale-95 shadow-lg">
          Zobacz Funkcje
        </a>
      </div>

      <!-- Stats -->
      <div class="flex flex-wrap items-center justify-center gap-8 pt-8">
        <div class="text-center">
          <div class="text-3xl font-bold text-gray-900">7</div>
          <div class="text-sm text-gray-600">Stylów Postów</div>
        </div>
        <div class="w-px h-12 bg-gray-300"></div>
        <div class="text-center">
          <div class="text-3xl font-bold text-gray-900">6</div>
          <div class="text-sm text-gray-600">Języków</div>
        </div>
        <div class="w-px h-12 bg-gray-300"></div>
        <div class="text-center">
          <div class="text-3xl font-bold text-gray-900">∞</div>
          <div class="text-sm text-gray-600">Możliwości</div>
        </div>
      </div>
    </div>

    <!-- Floating elements -->
    <div class="absolute top-1/4 left-10 animate-float hidden lg:block" style="animation-delay: 0ms;">
      <div class="text-6xl opacity-20">✨</div>
    </div>
    <div class="absolute top-1/3 right-10 animate-float hidden lg:block" style="animation-delay: 1000ms;">
      <div class="text-6xl opacity-20">🚀</div>
    </div>
    <div class="absolute bottom-1/4 left-20 animate-float hidden lg:block" style="animation-delay: 2000ms;">
      <div class="text-6xl opacity-20">💡</div>
    </div>
  </section>

  <!-- Main App -->
  <section id="generator" class="mb-20">
    <App client:load />
  </section>

  <!-- Features Section - Bento Grid -->
  <section id="features" class="my-32">
    <div class="text-center mb-16 space-y-4">
      <h2 class="text-4xl md:text-5xl font-bold">
        Wszystko Czego
        <span class="instagram-gradient bg-clip-text text-transparent">Potrzebujesz</span>
      </h2>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto">
        Kompleksowe narzędzie do tworzenia profesjonalnego contentu na Instagram
      </p>
    </div>

    <!-- Bento Grid Layout -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl mx-auto">
      <!-- Large Feature -->
      <div class="md:col-span-2 md:row-span-2 group relative overflow-hidden rounded-3xl bg-gradient-to-br from-purple-500 via-pink-500 to-orange-500 p-1">
        <div class="h-full bg-white rounded-[calc(1.5rem-4px)] p-8">
          <div class="flex flex-col h-full justify-between">
            <div>
              <div class="text-6xl mb-6">🎨</div>
              <h3 class="text-3xl font-bold mb-4">7 Unikalnych Stylów</h3>
              <p class="text-gray-600 text-lg leading-relaxed">
                Profesjonalny, casualowy, edukacyjny, motywacyjny, humorystyczny, storytelling i promocyjny. Każdy post dopasowany do Twojej marki.
              </p>
            </div>
            <div class="flex flex-wrap gap-2 mt-6">
              <span class="px-3 py-1 rounded-full bg-purple-100 text-purple-700 text-sm font-medium">Professional</span>
              <span class="px-3 py-1 rounded-full bg-pink-100 text-pink-700 text-sm font-medium">Casual</span>
              <span class="px-3 py-1 rounded-full bg-orange-100 text-orange-700 text-sm font-medium">Educational</span>
              <span class="px-3 py-1 rounded-full bg-blue-100 text-blue-700 text-sm font-medium">Motivational</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Small Feature 1 -->
      <div class="group relative overflow-hidden rounded-3xl bg-gradient-to-br from-blue-500 to-cyan-500 p-1 hover:scale-105 transition-transform">
        <div class="h-full bg-white rounded-[calc(1.5rem-4px)] p-6">
          <div class="text-4xl mb-4">🌍</div>
          <h3 class="text-xl font-bold mb-2">Multi-językowe</h3>
          <p class="text-gray-600 text-sm">
            6 języków: PL, EN, ES, DE, FR, IT
          </p>
        </div>
      </div>

      <!-- Small Feature 2 -->
      <div class="group relative overflow-hidden rounded-3xl bg-gradient-to-br from-green-500 to-emerald-500 p-1 hover:scale-105 transition-transform">
        <div class="h-full bg-white rounded-[calc(1.5rem-4px)] p-6">
          <div class="text-4xl mb-4">#️⃣</div>
          <h3 class="text-xl font-bold mb-2">Smart Hashtagi</h3>
          <p class="text-gray-600 text-sm">
            Automatyczne generowanie relevantnych hashtagów
          </p>
        </div>
      </div>

      <!-- Medium Feature 1 -->
      <div class="md:col-span-2 group relative overflow-hidden rounded-3xl bg-gradient-to-r from-pink-500 to-rose-500 p-1">
        <div class="h-full bg-white rounded-[calc(1.5rem-4px)] p-8">
          <div class="flex items-center gap-6">
            <div class="text-5xl">📸</div>
            <div class="flex-1">
              <h3 class="text-2xl font-bold mb-2">Propozycje Zdjęć AI</h3>
              <p class="text-gray-600">
                Otrzymuj gotowe prompty do Midjourney, DALL-E i innych generatorów obrazów
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Small Feature 3 -->
      <div class="group relative overflow-hidden rounded-3xl bg-gradient-to-br from-amber-500 to-orange-500 p-1 hover:scale-105 transition-transform">
        <div class="h-full bg-white rounded-[calc(1.5rem-4px)] p-6">
          <div class="text-4xl mb-4">🎯</div>
          <h3 class="text-xl font-bold mb-2">8 Typów CTA</h3>
          <p class="text-gray-600 text-sm">
            Link w bio, komentarze, DM i więcej
          </p>
        </div>
      </div>

      <!-- Small Feature 4 -->
      <div class="group relative overflow-hidden rounded-3xl bg-gradient-to-br from-violet-500 to-purple-500 p-1 hover:scale-105 transition-transform">
        <div class="h-full bg-white rounded-[calc(1.5rem-4px)] p-6">
          <div class="text-4xl mb-4">🔒</div>
          <h3 class="text-xl font-bold mb-2">100% Bezpieczne</h3>
          <p class="text-gray-600 text-sm">
            Walidacja Zod + opcjonalny Turnstile
          </p>
        </div>
      </div>

      <!-- Small Feature 5 -->
      <div class="group relative overflow-hidden rounded-3xl bg-gradient-to-br from-red-500 to-pink-500 p-1 hover:scale-105 transition-transform">
        <div class="h-full bg-white rounded-[calc(1.5rem-4px)] p-6">
          <div class="text-4xl mb-4">⚡</div>
          <h3 class="text-xl font-bold mb-2">Szybkie</h3>
          <p class="text-gray-600 text-sm">
            Wygeneruj post w mniej niż 10 sekund
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Social Proof / Testimonials -->
  <section class="my-32">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold mb-4">
        Zaufali Nam
        <span class="instagram-gradient bg-clip-text text-transparent">Tysiące Twórców</span>
      </h2>
      <p class="text-xl text-gray-600">Zobacz co mówią o nas użytkownicy</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl mx-auto">
      <!-- Testimonial 1 -->
      <div class="group backdrop-blur-md bg-white/60 border border-white/20 rounded-2xl p-6 shadow-xl hover:shadow-2xl transition-all hover:-translate-y-2">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-12 h-12 rounded-full bg-gradient-to-br from-purple-400 to-pink-400"></div>
          <div>
            <div class="font-semibold">Anna K.</div>
            <div class="text-sm text-gray-600">@annakdesign</div>
          </div>
        </div>
        <p class="text-gray-700 mb-4">
          "Narzędzie oszczędza mi godziny pracy! Posty są zawsze na punkcie i pasują do mojej marki. Must-have dla każdego content creatora! 🚀"
        </p>
        <div class="flex text-yellow-400">
          ⭐⭐⭐⭐⭐
        </div>
      </div>

      <!-- Testimonial 2 -->
      <div class="group backdrop-blur-md bg-white/60 border border-white/20 rounded-2xl p-6 shadow-xl hover:shadow-2xl transition-all hover:-translate-y-2">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-12 h-12 rounded-full bg-gradient-to-br from-blue-400 to-cyan-400"></div>
          <div>
            <div class="font-semibold">Marek P.</div>
            <div class="text-sm text-gray-600">@marekphoto</div>
          </div>
        </div>
        <p class="text-gray-700 mb-4">
          "AI generuje lepsze teksty niż ja sam 😅 Hashtagi są zawsze trafione, a propozycje zdjęć inspirujące. Genialnie!"
        </p>
        <div class="flex text-yellow-400">
          ⭐⭐⭐⭐⭐
        </div>
      </div>

      <!-- Testimonial 3 -->
      <div class="group backdrop-blur-md bg-white/60 border border-white/20 rounded-2xl p-6 shadow-xl hover:shadow-2xl transition-all hover:-translate-y-2">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-12 h-12 rounded-full bg-gradient-to-br from-green-400 to-emerald-400"></div>
          <div>
            <div class="font-semibold">Zuza M.</div>
            <div class="text-sm text-gray-600">@zuzafit</div>
          </div>
        </div>
        <p class="text-gray-700 mb-4">
          "Używam codziennie! Różne style pozwalają mi eksperymentować, a wyniki są zawsze profesjonalne. Polecam każdemu! 💪"
        </p>
        <div class="flex text-yellow-400">
          ⭐⭐⭐⭐⭐
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="my-32 relative overflow-hidden rounded-3xl">
    <!-- Background -->
    <div class="absolute inset-0 bg-gradient-to-r from-purple-600 via-pink-600 to-orange-500"></div>
    <div class="absolute inset-0 bg-grid-pattern opacity-10"></div>

    <!-- Content -->
    <div class="relative z-10 text-center py-20 px-6">
      <h2 class="text-4xl md:text-6xl font-bold text-white mb-6">
        Gotowy na Rozpoczęcie?
      </h2>
      <p class="text-xl text-white/90 mb-8 max-w-2xl mx-auto">
        Dołącz do tysięcy twórców którzy już korzystają z AI do generowania contentu
      </p>
      <a href="#generator" class="inline-flex items-center gap-2 px-8 py-4 bg-white text-purple-600 rounded-xl font-bold text-lg hover:scale-105 transition-transform shadow-2xl">
        Zacznij Tworzyć Teraz
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
    </div>
  </section>

  <!-- FAQ Section -->
  <section id="faq" class="mt-32 mb-12 max-w-3xl mx-auto">
    <h3 class="text-4xl font-bold text-center mb-12">
      Często <span class="instagram-gradient bg-clip-text text-transparent">Zadawane Pytania</span>
    </h3>
    <div class="space-y-4">
      <details class="group p-6 backdrop-blur-md bg-white/80 rounded-2xl shadow-lg border border-gray-200 hover:border-purple-300 transition-all">
        <summary class="font-semibold text-lg cursor-pointer flex items-center justify-between">
          <span>Jak działa generator?</span>
          <svg class="w-5 h-5 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>
        <p class="mt-4 text-gray-600 leading-relaxed">
          Wypełnij formularz z informacjami o temacie posta, stylu i innych parametrach.
          Nasza AI wygeneruje dla Ciebie kompletny post wraz z hashtagami i propozycjami zdjęć.
        </p>
      </details>

      <details class="group p-6 backdrop-blur-md bg-white/80 rounded-2xl shadow-lg border border-gray-200 hover:border-purple-300 transition-all">
        <summary class="font-semibold text-lg cursor-pointer flex items-center justify-between">
          <span>Czy mogę edytować wygenerowany post?</span>
          <svg class="w-5 h-5 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>
        <p class="mt-4 text-gray-600 leading-relaxed">
          Oczywiście! Wygenerowany tekst możesz skopiować i edytować według własnych potrzeb.
          Traktuj to jako punkt startowy dla swojego contentu.
        </p>
      </details>

      <details class="group p-6 backdrop-blur-md bg-white/80 rounded-2xl shadow-lg border border-gray-200 hover:border-purple-300 transition-all">
        <summary class="font-semibold text-lg cursor-pointer flex items-center justify-between">
          <span>Czy moje dane są bezpieczne?</span>
          <svg class="w-5 h-5 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>
        <p class="mt-4 text-gray-600 leading-relaxed">
          Tak! Twoje dane są przesyłane bezpiecznie i nie są przechowywane dłużej niż to konieczne.
          Opcjonalnie możesz włączyć Cloudflare Turnstile dla dodatkowej ochrony.
        </p>
      </details>

      <details class="group p-6 backdrop-blur-md bg-white/80 rounded-2xl shadow-lg border border-gray-200 hover:border-purple-300 transition-all">
        <summary class="font-semibold text-lg cursor-pointer flex items-center justify-between">
          <span>Ile kosztuje generowanie postów?</span>
          <svg class="w-5 h-5 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>
        <p class="mt-4 text-gray-600 leading-relaxed">
          Aktualnie aplikacja jest w wersji BETA i jest całkowicie darmowa!
          W przyszłości planujemy wprowadzić plany premium z dodatkowymi funkcjami.
        </p>
      </details>
    </div>
  </section>
</BaseLayout>

<style>
  .bg-grid-pattern {
    background-image: linear-gradient(to right, #ffffff20 1px, transparent 1px),
                      linear-gradient(to bottom, #ffffff20 1px, transparent 1px);
    background-size: 40px 40px;
  }
</style>
