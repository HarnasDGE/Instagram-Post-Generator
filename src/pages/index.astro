---
import BaseLayout from '@layouts/BaseLayout.astro';
import App from '@components/App';
---

<BaseLayout>
  <!-- Hero Section -->
  <section class="text-center mb-12 animate-fade-in">
    <h2 class="text-4xl md:text-5xl font-bold mb-4 instagram-gradient bg-clip-text text-transparent">
      Generuj Profesjonalne Posty na Instagram
    </h2>
    <p class="text-lg md:text-xl text-gray-600 max-w-2xl mx-auto">
      Wykorzystaj AI do tworzenia angażujących postów. Wybierz styl, język i inne parametry,
      a my stworzymy dla Ciebie idealny content.
    </p>
  </section>

  <!-- Main App -->
  <App client:load />

  <!-- Features Section -->
  <section id="features" class="mt-20 mb-12">
    <h3 class="text-3xl font-bold text-center mb-10">Kluczowe Funkcje</h3>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
      <div class="p-6 bg-white rounded-xl shadow-sm border border-gray-200">
        <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center mb-4">
          <span class="text-2xl">🎨</span>
        </div>
        <h4 class="font-semibold text-lg mb-2">Różne Style</h4>
        <p class="text-sm text-gray-600">
          Wybierz spośród 7 stylów: profesjonalny, casualowy, edukacyjny i więcej
        </p>
      </div>

      <div class="p-6 bg-white rounded-xl shadow-sm border border-gray-200">
        <div class="w-12 h-12 bg-pink-100 rounded-lg flex items-center justify-center mb-4">
          <span class="text-2xl">🌍</span>
        </div>
        <h4 class="font-semibold text-lg mb-2">Multi-językowe</h4>
        <p class="text-sm text-gray-600">
          Twórz posty w 6 językach: polski, angielski, hiszpański i inne
        </p>
      </div>

      <div class="p-6 bg-white rounded-xl shadow-sm border border-gray-200">
        <div class="w-12 h-12 bg-orange-100 rounded-lg flex items-center justify-center mb-4">
          <span class="text-2xl">📸</span>
        </div>
        <h4 class="font-semibold text-lg mb-2">Propozycje Zdjęć</h4>
        <p class="text-sm text-gray-600">
          Otrzymaj prompty do generowania zdjęć w AI (Midjourney, DALL-E)
        </p>
      </div>

      <div class="p-6 bg-white rounded-xl shadow-sm border border-gray-200">
        <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mb-4">
          <span class="text-2xl">#️⃣</span>
        </div>
        <h4 class="font-semibold text-lg mb-2">Smart Hashtagi</h4>
        <p class="text-sm text-gray-600">
          Automatyczne generowanie relevantnych hashtagów dla lepszego zasięgu
        </p>
      </div>

      <div class="p-6 bg-white rounded-xl shadow-sm border border-gray-200">
        <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center mb-4">
          <span class="text-2xl">🎯</span>
        </div>
        <h4 class="font-semibold text-lg mb-2">Call-to-Action</h4>
        <p class="text-sm text-gray-600">
          Wybierz odpowiedni CTA: link w bio, komentarze, udostępnienia i więcej
        </p>
      </div>

      <div class="p-6 bg-white rounded-xl shadow-sm border border-gray-200">
        <div class="w-12 h-12 bg-yellow-100 rounded-lg flex items-center justify-center mb-4">
          <span class="text-2xl">🔒</span>
        </div>
        <h4 class="font-semibold text-lg mb-2">Bezpieczne</h4>
        <p class="text-sm text-gray-600">
          Zabezpieczone Cloudflare Turnstile i walidacja formularzy
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section id="faq" class="mt-20 mb-12 max-w-3xl mx-auto">
    <h3 class="text-3xl font-bold text-center mb-10">Często Zadawane Pytania</h3>
    <div class="space-y-4">
      <details class="p-6 bg-white rounded-xl shadow-sm border border-gray-200">
        <summary class="font-semibold cursor-pointer">Jak działa generator?</summary>
        <p class="mt-3 text-sm text-gray-600">
          Wypełnij formularz z informacjami o temacie posta, stylu i innych parametrach.
          Nasza AI wygeneruje dla Ciebie kompletny post wraz z hashtagami i propozycjami zdjęć.
        </p>
      </details>

      <details class="p-6 bg-white rounded-xl shadow-sm border border-gray-200">
        <summary class="font-semibold cursor-pointer">Czy mogę edytować wygenerowany post?</summary>
        <p class="mt-3 text-sm text-gray-600">
          Oczywiście! Wygenerowany tekst możesz skopiować i edytować według własnych potrzeb.
          Traktuj to jako punkt startowy dla swojego contentu.
        </p>
      </details>

      <details class="p-6 bg-white rounded-xl shadow-sm border border-gray-200">
        <summary class="font-semibold cursor-pointer">Czy moje dane są bezpieczne?</summary>
        <p class="mt-3 text-sm text-gray-600">
          Tak! Używamy Cloudflare Turnstile do ochrony formularza. Twoje dane są przesyłane
          bezpiecznie i nie są przechowywane dłużej niż to konieczne.
        </p>
      </details>

      <details class="p-6 bg-white rounded-xl shadow-sm border border-gray-200">
        <summary class="font-semibold cursor-pointer">Ile kosztuje generowanie postów?</summary>
        <p class="mt-3 text-sm text-gray-600">
          Informacje o cenach i planach subskrypcyjnych będą dostępne wkrótce.
          Obecnie pracujemy nad modelem cenowym.
        </p>
      </details>
    </div>
  </section>
</BaseLayout>
